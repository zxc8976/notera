# 環境配置範例
# 複製此檔案為 .env 並根據您的環境修改

# ============================================
# 服務端口配置
# ============================================
FRONTEND_PORT=51730
BACKEND_PORT=8000
OLLAMA_PORT=11434

# ============================================
# GPU 支持配置
# ============================================
# 是否啟用 GPU 加速 (true/false)
USE_GPU=false
# 啟用 Paddle GPU 版本 (true/false)
USE_PADDLE_GPU=false
# NVIDIA GPU 設備 (all 或特定設備 ID，如 0,1)
NVIDIA_VISIBLE_DEVICES=all

# ============================================
# LLM 提供者配置
# ============================================
# LLM 提供者 (ollama/openai)
LLM_PROVIDER=ollama
# Ollama 基礎 URL
OLLAMA_BASE=http://ollama_local:11434
OLLAMA_FALLBACK_BASE=http://ollama_local:11434

# ============================================
# 應用程式配置
# ============================================
# Node 環境 (development/production)
NODE_ENV=development
# Python 路徑
PYTHONPATH=/app:/app/source

# ============================================
# 功能開關
# ============================================
# 啟用數學工具
ENABLE_MATH_TOOL=true
# 啟用 LLM 回退機制
LLM_FALLBACK_ENABLED=true
# 啟用筆記分析調試
NOTE_ANALYSIS_DEBUG=false

# ============================================
# 模型配置
# ============================================
# PaddleOCR-VL 模型根目錄
PADDLEOCR_VL_MODEL_ROOT=/app/data/models/paddleocr_vl
# PaddleOCR-VL 版面分析目錄
PADDLEOCR_VL_LAYOUT_DIR=/app/data/models/paddleocr_vl/PP-DocLayoutV2

# ============================================
# 代理配置 (可選)
# ============================================
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# ============================================
# OpenCode 開發工具 (可選)
# ============================================
# OPENCODE_EXPERIMENTAL_LSP_TOOL=true
